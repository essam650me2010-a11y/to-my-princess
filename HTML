                </p>
                <div class="grid grid-cols-4 gap-2.5 sm:gap-4 max-w-xl mx-auto">
                    <div class="editorial-glass rounded-2xl p-3 sm:p-5 border border-rubyGlow/35">
                        <span id="liveDays" class="block text-2xl sm:text-4xl font-black text-white ruby-text-glow">0</span>
                        <span class="text-xs text-roseSilk font-bold mt-1 block">يوم</span>
                    </div>
                    <div class="editorial-glass rounded-2xl p-3 sm:p-5 border border-rubyGlow/35">
                        <span id="liveHours" class="block text-2xl sm:text-4xl font-black text-white ruby-text-glow">0</span>
                        <span class="text-xs text-roseSilk font-bold mt-1 block">ساعة</span>
                    </div>
                    <div class="editorial-glass rounded-2xl p-3 sm:p-5 border border-rubyGlow/35">
                        <span id="liveMinutes" class="block text-2xl sm:text-4xl font-black text-white ruby-text-glow">0</span>
                        <span class="text-xs text-roseSilk font-bold mt-1 block">دقيقة</span>
                    </div>
                    <div class="editorial-glass rounded-2xl p-3 sm:p-5 border border-champagne/50">
                        <span id="liveSeconds" class="block text-2xl sm:text-4xl font-black text-champagne">0</span>
                        <span class="text-xs text-champagne font-bold mt-1 block">ثانية</span>
                    </div>
                </div>
            </div>

            <!-- زر الانتقال للمشهد الثالث -->
            <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
                <button onclick="switchScene(3)" class="magnetic-gold-btn px-8 py-4 rounded-2xl font-black text-base sm:text-lg flex items-center gap-3 cursor-pointer">
                    <span>ذكرياتنا الحلوة 📸</span>
                    <i class="fas fa-arrow-left"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- =========================================================
         المشهد الثالث: معرض اللحظات السعيدة (3D Memory Gallery)
         ========================================================= -->
    <section id="scene3" class="cinematic-scene relative z-30 min-h-screen flex-col items-center justify-center px-5 py-24">
        <div class="max-w-6xl w-full mx-auto">
            <div class="text-center mb-12">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-rubyRoyal/20 border border-rubyGlow/40 text-roseSilk text-xs font-bold mb-3">
                    <i class="fas fa-camera-retro text-champagne"></i>
