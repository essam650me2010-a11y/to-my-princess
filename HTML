    <script>
        const ATTACHED_MEMORY_IMAGE = "image_6f8d23.png";

        /* =========================================================
           1. توليد بطاقات فنية افتراضية فاخرة (SVG)
           ========================================================= */
        function createRoyalArtSVG(c1, c2, title, sub) {
            const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" width="700" height="700" viewBox="0 0 700 700">
                <defs>
                    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="${c1}"/>
                        <stop offset="100%" stop-color="${c2}"/>
                    </linearGradient>
                    <radialGradient id="halo" cx="50%" cy="42%" r="48%">
                        <stop offset="0%" stop-color="#f5d08a" stop-opacity="0.4"/>
                        <stop offset="100%" stop-color="transparent"/>
                    </radialGradient>
                </defs>
                <rect width="700" height="700" fill="url(#g)"/>
                <circle cx="350" cy="290" r="240" fill="url(#halo)"/>
                <circle cx="350" cy="290" r="155" fill="none" stroke="#f5d08a" stroke-width="1.5" stroke-dasharray="6 8" opacity="0.55"/>
                <path d="M350 400 C350 400 220 312 220 230 C220 184 257 152 296 152 C322 152 341 168 350 187 C359 168 378 152 404 152 C443 152 480 184 480 230 C480 312 350 400 350 400 Z" fill="#ff1e56" opacity="0.92"/>
                <path d="M350 380 C350 380 245 308 245 240 C245 204 274 178 306 178 C327 178 343 190 350 206 C357 190 373 178 394 178 C426 178 455 204 455 240 C455 308 350 380 350 380 Z" fill="#f5d08a" opacity="0.88"/>
                <text x="350" y="495" font-family="Cairo, Arial, sans-serif" font-size="34" fill="#ffffff" text-anchor="middle" font-weight="bold">${title}</text>
                <text x="350" y="542" font-family="Cairo, Arial, sans-serif" font-size="20" fill="#f5d08a" text-anchor="middle">${sub}</text>
            </svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }

        const DEFAULT_DATA = {
            herName: "أميرتي",
            specialDateRaw: "2023-02-14",
            specialDateDisplay: "14 فبراير 2023",
            dateHeading: "اليوم اللي بدأت فيه حكايتنا",
            dateQuote: "في اليوم ده تحديداً، اتولد قلبي من جديد وبقى لعمري أجمل معنى بوجودك",
            photos: [
                {
                    url: ATTACHED_MEMORY_IMAGE,
                    date: "بداية الحكاية",
                    caption: "أول مرة عيني جت في عينك.. حسيت إن الدنيا كلها وقفت عندك"
                },
                {
                    url: ATTACHED_MEMORY_IMAGE,
                    date: "أجمل يوم",
                    caption: "ضحكتك هي أحلى موسيقى سمعتها في حياتي وسبب سعادتي كل يوم"
                },
                {
                    url: ATTACHED_MEMORY_IMAGE,
                    date: "وعد العمر كله",
                    caption: "معاكي كل لحظة بتتحول لذكرى محفورة في قلبي للأبد"
                }
            ],
            creditsText: `إلى حبيبتي ونور عيني...\n\nمكنتش أعرف إن في إنسان ممكن يغير الكون كله في عيني،\nلحد ما دخلتي حياتي ونورتي كل تفصيلة فيها.\n\nمن يوم ما عرفتك وأنا بشكر ربنا عليكي كل لحظة،\nلأنك أجمل نعمة وأغلى هدية جتلي في عمري.\n\nإنتي مش بس حبيبتي،\nإنتي أماني، وسندي، وضحكتي اللي طالعة من القلب،\nوالمكان اللي برتاح فيه من الدنيا كلها.\n\nشكراً على حبك، على اهتمامك،\nوعلى وجودك جنبي في كل وقت.\n\nأوعدك إني هفضل أحبك وأحافظ عليكي،\nوكل سنة وإحنا مع بعض وبنكبر سوا في حب وسعادة.\n\nبحبك للأبد ❤️`
        };

        const STORAGE_KEY = 'royalLoveExperience_v3_attached';
        let appData = window.__EMBEDDED_ROYAL_GIFT__ || JSON.parse(localStorage.getItem(STORAGE_KEY)) || JSON.parse(JSON.stringify(DEFAULT_DATA));
        if (appData && Array.isArray(appData.photos)) {
            appData.photos = appData.photos.map(p => ({
                ...p,
                url: (!p.url || p.url.startsWith('data:image/svg+xml')) ? ATTACHED_MEMORY_IMAGE : p.url
            }));
        }

        /* =========================================================
           2. محرك النجوم، بتلات الورد، أثر اللمس، والألعاب النارية (60fps Canvas)
           ========================================================= */
        const canvas = document.getElementById('universeCanvas');
        const ctx = canvas.getContext('2d');
        let W = window.innerWidth;
        let H = window.innerHeight;

        function resizeUniverse() {
            W = canvas.width = window.innerWidth;
            H = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeUniverse);
        resizeUniverse();

        const stars = [];
        const particles = [];

        // إنشاء نجوم متلألئة في السماء
        for (let i = 0; i < 85; i++) {
            stars.push({
                x: Math.random() * W,
                y: Math.random() * H,
                r: Math.random() * 1.8 + 0.4,
                phase: Math.random() * Math.PI * 2,
                speed: Math.random() * 0.03 + 0.01,
                color: Math.random() > 0.3 ? '#f5d08a' : '#ffffff'
            });
        }

        class LoveParticle {
            constructor(x, y, kind = 'trail') {
                this.x = x;
                this.y = y;
                this.kind = kind; // 'trail' | 'petal' | 'firework'
                this.alpha = 1;
                this.rotation = Math.random() * Math.PI * 2;
                this.rotSpeed = (Math.random() - 0.5) * 0.08;

                if (kind === 'trail') {
                    this.shape = Math.random() > 0.45 ? 'heart' : 'star';
                    this.size = Math.random() * 8 + 4;
                    this.vx = (Math.random() - 0.5) * 1.8;
                    this.vy = -(Math.random() * 1.6 + 0.5);
                    this.decay = 0.024;
                    this.color = Math.random() > 0.45 ? '#f5d08a' : '#ff1e56';
                } else if (kind === 'petal') {
                    this.shape = Math.random() > 0.35 ? 'petal' : 'heart';
                    this.size = Math.random() * 11 + 6;
                    this.vx = (Math.random() - 0.5) * 2.5;
                    this.vy = Math.random() * 2.2 + 1.2;
                    this.sway = Math.random() * 0.05 + 0.02;
                    this.swayOffset = Math.random() * Math.PI * 2;
                    this.decay = 0.005;
                    this.color = Math.random() > 0.3 ? '#d90429' : '#f5d08a';
                } else if (kind === 'firework') {
                    this.shape = Math.random() > 0.3 ? 'heart' : 'spark';
                    this.size = Math.random() * 13 + 6;
                    const angle = Math.random() * Math.PI * 2;
                    const force = Math.random() * 10 + 3;
                    this.vx = Math.cos(angle) * force;
                    this.vy = Math.sin(angle) * force - 1.5;
                    this.gravity = 0.13;
                    this.decay = 0.013;
                    this.color = ['#ff1e56', '#f5d08a', '#ff758f', '#ffffff'][Math.floor(Math.random() * 4)];
                }
            }

            update() {
                this.rotation += this.rotSpeed;
                if (this.kind === 'petal') {
                    this.x += this.vx + Math.sin(this.y * 0.02 + this.swayOffset) * 1.2;
                    this.y += this.vy;
                } else if (this.kind === 'firework') {
                    this.x += this.vx;
                    this.y += this.vy;
                    this.vy += this.gravity;
                    this.vx *= 0.97;
                } else {
                    this.x += this.vx;
                    this.y += this.vy;
                }
                this.alpha -= this.decay;
            }

            draw() {
                if (this.alpha <= 0) return;
                ctx.save();
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 10;

                if (this.shape === 'heart') {
                    const s = this.size;
                    ctx.beginPath();
                    ctx.moveTo(0, -s * 0.2);
                    ctx.bezierCurveTo(0, -s * 0.5, -s * 0.5, -s * 0.5, -s * 0.5, -s * 0.2);
                    ctx.bezierCurveTo(-s * 0.5, s * 0.15, 0, s * 0.35, 0, s * 0.5);
                    ctx.bezierCurveTo(0, s * 0.35, s * 0.5, s * 0.15, s * 0.5, -s * 0.2);
                    ctx.bezierCurveTo(s * 0.5, -s * 0.5, 0, -s * 0.5, 0, -s * 0.2);
                    ctx.fill();
                } else if (this.shape === 'petal') {
                    const s = this.size;
                    ctx.beginPath();
                    ctx.ellipse(0, 0, s * 0.65, s * 0.35, 0, 0, Math.PI * 2);
                    ctx.fill();
                } else {
                    ctx.beginPath();
                    ctx.arc(0, 0, this.size * 0.4, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.restore();
            }
        }

        function spawnFireworkBurst(x, y, count = 55) {
            for (let i = 0; i < count; i++) {
                particles.push(new LoveParticle(x, y, 'firework'));
            }
        }

        function showerRosePetals(count = 45) {
            for (let i = 0; i < count; i++) {
                particles.push(new LoveParticle(Math.random() * W, -20 - Math.random() * 200, 'petal'));
            }
        }

        // تفاعل حركة الماوس ولمس الشاشة
        let lastPointerStamp = 0;
        function emitPointerTrail(x, y) {
            const now = Date.now();
            if (now - lastPointerStamp > 32) {
                particles.push(new LoveParticle(x, y, 'trail'));
                lastPointerStamp = now;
            }
        }

        window.addEventListener('mousemove', e => emitPointerTrail(e.clientX, e.clientY));
        window.addEventListener('touchmove', e => {
            if (e.touches[0]) emitPointerTrail(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });

        function renderCanvasFrame() {
            ctx.clearRect(0, 0, W, H);

            // رسم النجوم المتلألئة
            for (let s of stars) {
                s.phase += s.speed;
                const alpha = 0.25 + Math.abs(Math.sin(s.phase)) * 0.75;
                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.fillStyle = s.color;
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // رسم الجزيئات والقلوب والبتلات
            for (let i = particles.length - 1; i >= 0; i--) {
                particles[i].update();
                particles[i].draw();
                if (particles[i].alpha <= 0 || particles[i].y > H + 50) {
                    particles.splice(i, 1);
                }
            }

            requestAnimationFrame(renderCanvasFrame);
        }

        /* =========================================================
           3. محرك البيانو الرومانسي المولد برمجياً (Web Audio API)
           ========================================================= */
        let audioCtx = null;
        let isMusicPlaying = false;
        let melodyInterval = null;
        let noteStep = 0;

        // مقطوعة بيانو رومانسية هادئة (Arpeggio in C Major / A Minor / F Major / G)
        const romanticMelody = [
            261.63, 329.63, 392.00, 493.88, 523.25, 493.88, 392.00, 329.63, // Cmaj7
            220.00, 261.63, 329.63, 392.00, 440.00, 392.00, 329.63, 261.63, // Am7
            174.61, 220.00, 261.63, 349.23, 440.00, 349.23, 261.63, 220.00, // Fmaj7
            196.00, 246.94, 293.66, 392.00, 493.88, 392.00, 293.66, 246.94  // G6
        ];

        function triggerPianoNote(freq) {
            if (!audioCtx) return;
            const now = audioCtx.currentTime;

            const osc1 = audioCtx.createOscillator();
            const osc2 = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc1.type = 'sine';
            osc2.type = 'triangle';
            osc1.frequency.setValueAtTime(freq, now);
            osc2.frequency.setValueAtTime(freq * 2, now); // توافقية ناعمة

            const subGain = audioCtx.createGain();
            subGain.gain.setValueAtTime(0.15, now);

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.exponentialRampToValueAtTime(0.055, now + 0.04);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.4);

            osc1.connect(gain);
            osc2.connect(subGain);
            subGain.connect(gain);
            gain.connect(audioCtx.destination);

            osc1.start(now);
            osc2.start(now);
            osc1.stop(now + 2.5);
            osc2.stop(now + 2.5);
        }

        function startPianoMusic() {
            if (isMusicPlaying) return;
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();

            isMusicPlaying = true;
            document.getElementById('audioPing').classList.remove('hidden');
            document.getElementById('audioIcon').className = 'fas fa-volume-high';
            document.getElementById('audioLabel').textContent = 'كتم الصوت';

            const playNext = () => {
                triggerPianoNote(romanticMelody[noteStep % romanticMelody.length]);
                noteStep++;
            };
            playNext();
            melodyInterval = setInterval(playNext, 540);
        }

        function stopPianoMusic() {
            isMusicPlaying = false;
            clearInterval(melodyInterval);
            document.getElementById('audioPing').classList.add('hidden');
            document.getElementById('audioIcon').className = 'fas fa-volume-xmark';
            document.getElementById('audioLabel').textContent = 'تشغيل الموسيقى';
        }

        function togglePianoMusic() {
            if (isMusicPlaying) stopPianoMusic();
            else startPianoMusic();
        }

