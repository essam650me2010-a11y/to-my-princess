            showToast('تمت استعادة الإعدادات الافتراضية');
        }

        // توليد وتحميل ملف HTML نهائي مدمج به كل الصور والكلام ومخفي منه زر الإعدادات تماماً
        function exportReadyGiftFile() {
            commitDataFromInputs();

            const clonedDoc = document.documentElement.cloneNode(true);

            // إزالة زر التخصيص ولوحة التخصيص بالكامل من النسخة المرسلة للحبيبة
            const cornerBtn = clonedDoc.querySelector('#customizerCornerWrapper');
            if (cornerBtn) cornerBtn.remove();
            const drawer = clonedDoc.querySelector('#customizerDrawer');
            if (drawer) drawer.remove();

            // تضمين البيانات المخصصة (بما فيها الصور Base64) داخل ملف الـ HTML
            const embeddedScript = document.createElement('script');
            embeddedScript.textContent = `window.__EMBEDDED_ROYAL_GIFT__ = ${JSON.stringify(appData)};`;
            clonedDoc.querySelector('head').insertBefore(embeddedScript, clonedDoc.querySelector('head').firstChild);

            const htmlOutput = '<!DOCTYPE html>\n' + clonedDoc.outerHTML;
            const blob = new Blob([htmlOutput], { type: 'text/html;charset=utf-8' });
            const downloadLink = document.createElement('a');
            downloadLink.href = URL.createObjectURL(blob);
            downloadLink.download = `هدية_${appData.herName.replace(/\s+/g, '_')}.html`;
            downloadLink.click();

            closeCustomizerDrawer();
            showToast('تم تحميل الملف النهائي الجاهز للإرسال! 🎁');
        }

        function showToast(msg) {
            const t = document.getElementById('toastNotification');
            t.textContent = msg;
            t.classList.remove('hidden');
            setTimeout(() => t.classList.add('hidden'), 3500);
        }

        /* =========================================================
           10. تشغيل التجربة عند تحميل الصفحة
           ========================================================= */
        window.onload = function() {
            // إخفاء زر التخصيص تلقائياً إذا كانت هذه نسخة مرسلة للحبيبة
            if (window.__EMBEDDED_ROYAL_GIFT__) {
                const corner = document.getElementById('customizerCornerWrapper');
                if (corner) corner.remove();
            }

            renderCanvasFrame();
            populateAllScenes();
            startLoveLoaderSequence();
        };
    </script>
</body>
