<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>حكايتنا الأبدية | عالمنا الخاص ✨</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Aref Ruqaa, Amiri, Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        ruqaa: ['"Aref Ruqaa"', 'serif'],
                        amiri: ['Amiri', 'serif'],
                        cairo: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        voidBlack: '#050208',
                        rubyRoyal: '#d90429',
                        rubyGlow: '#ff1e56',
                        champagne: '#f5d08a',
                        goldRoyal: '#d4af37',
                        roseSilk: '#f7cad0',
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --bg-void: #050208;
            --ruby: #ff1e56;
            --gold: #f5d08a;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-void);
            color: #fff8fa;
            overflow-x: hidden;
            min-height: 100vh;
            margin: 0;
        }

        /* =========================================================
           1. الخلفية المخملية والضباب المضيء المتحرك (Luxury Nebula)
           ========================================================= */
        .nebula-backdrop {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
            background: radial-gradient(circle at 50% 20%, #1b0514 0%, #09030e 55%, #050208 100%);
        }

        .nebula-cloud {
            position: absolute;
            border-radius: 50%;
            filter: blur(95px);
            opacity: 0.38;
            will-change: transform;
            animation: driftNebula 22s infinite alternate ease-in-out;
        }

        .cloud-ruby {
            width: 55vw; height: 55vw;
            max-width: 650px; max-height: 650px;
            background: radial-gradient(circle, #d90429 0%, transparent 70%);
            top: -15%; right: -10%;
        }

        .cloud-gold {
            width: 50vw; height: 50vw;
            max-width: 600px; max-height: 600px;
            background: radial-gradient(circle, #b8860b 0%, transparent 72%);
            bottom: -15%; left: -12%;
            opacity: 0.28;
            animation-duration: 28s;
            animation-delay: -6s;
        }

        .cloud-center {
            width: 40vw; height: 40vw;
            max-width: 480px; max-height: 480px;
            background: radial-gradient(circle, #6a0432 0%, transparent 70%);
            top: 40%; left: 30%;
            animation-duration: 25s;
            animation-delay: -11s;
        }

        @keyframes driftNebula {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-45px, 40px) scale(1.12); }
            100% { transform: translate(40px, -35px) scale(0.95); }
        }

        /* =========================================================
           2. النصوص الذهبية والزجاج الملكي (Editorial Glassmorphism)
           ========================================================= */
        .gold-foil-text {
            background: linear-gradient(135deg, #fff8e7 0%, #f5d08a 45%, #d4af37 75%, #fff2cc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 4px 20px rgba(245, 208, 138, 0.35));
        }

        .ruby-text-glow {
            text-shadow: 0 0 20px rgba(255, 30, 86, 0.8), 0 0 45px rgba(217, 4, 41, 0.5);
        }

        .editorial-glass {
            background: linear-gradient(155deg, rgba(255, 255, 255, 0.06) 0%, rgba(217, 4, 41, 0.04) 45%, rgba(5, 2, 8, 0.78) 100%);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            border: 1px solid rgba(245, 208, 138, 0.24);
            box-shadow:
                0 30px 70px -15px rgba(0, 0, 0, 0.85),
                inset 0 1px 1px rgba(255, 255, 255, 0.14);
        }

        /* =========================================================
           3. ستارة الانتقال الضوئية بين المشاهد (Light Curtain)
           ========================================================= */
        .light-curtain {
            position: fixed;
            inset: 0;
            z-index: 60;
            pointer-events: none;
            opacity: 0;
            background: radial-gradient(circle at center, rgba(255, 244, 214, 0.96) 0%, rgba(245, 208, 138, 0.85) 35%, rgba(217, 4, 41, 0.65) 75%, #050208 100%);
            transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .light-curtain.active {
            opacity: 1;
        }

        /* إدارة المشاهد الأربعة */
        .cinematic-scene {
            display: none;
            opacity: 0;
            transform: translateY(24px) scale(0.98);
            transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .cinematic-scene.active-scene {
            display: flex;
        }

        .cinematic-scene.visible-scene {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        /* =========================================================
           4. القلب الزجاجي 3D وحلقات الطاقة في المشهد الأول
           ========================================================= */
        .glass-heart-3d {
            position: relative;
            filter: drop-shadow(0 0 22px rgba(255, 30, 86, 0.85));
            animation: heartbeat3D 1.5s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
            transition: all 0.4s ease;
        }

        @keyframes heartbeat3D {
            0%, 100% { transform: scale(1); }
            15% { transform: scale(1.22); }
            30% { transform: scale(1.04); }
            45% { transform: scale(1.16); }
            70% { transform: scale(1); }
        }

        @keyframes spinClockwise {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @keyframes spinCounterClockwise {
            from { transform: rotate(360deg); }
            to { transform: rotate(0deg); }
        }

        .energy-ring-cw {
            transform-origin: 140px 140px;
            animation: spinClockwise 10s linear infinite;
        }

        .energy-ring-ccw {
            transform-origin: 140px 140px;
            animation: spinCounterClockwise 14s linear infinite;
        }

        /* الزر الذهبي المغناطيسي المتوهج */
        .magnetic-gold-btn {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #f5d08a 0%, #d4af37 50%, #f5d08a 100%);
            color: #09030e;
            box-shadow: 0 0 30px rgba(245, 208, 138, 0.55), 0 10px 25px rgba(0, 0, 0, 0.6);
            transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
        }

        .magnetic-gold-btn:hover {
            box-shadow: 0 0 45px rgba(245, 208, 138, 0.85), 0 15px 35px rgba(217, 4, 41, 0.4);
        }

        .magnetic-gold-btn::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 60%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.75), transparent);
            transform: skewX(-25deg);
            animation: goldShine 2.8s infinite;
        }

        @keyframes goldShine {
            0% { left: -100%; }
            45%, 100% { left: 160%; }
        }

        /* =========================================================
           5. بطاقات Polaroid ثلاثية الأبعاد (3D Tilt Gallery)
           ========================================================= */
        .polaroid-perspective {
            perspective: 1200px;
        }

        .polaroid-card {
            transform-style: preserve-3d;
            transition: transform 0.22s ease-out, box-shadow 0.35s ease, border-color 0.35s ease;
            background: linear-gradient(165deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.03) 100%);
            border: 1px solid rgba(245, 208, 138, 0.32);
            border-radius: 22px;
            padding: 14px 14px 26px 14px;
            box-shadow: 0 22px 45px rgba(0, 0, 0, 0.7);
            position: relative;
        }

        .polaroid-card:hover {
            border-color: rgba(245, 208, 138, 0.75);
            box-shadow: 0 30px 65px rgba(217, 4, 41, 0.3), 0 0 30px rgba(245, 208, 138, 0.25);
        }

        .polaroid-sheen {
            position: absolute;
            inset: 0;
            border-radius: 22px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .polaroid-card:hover .polaroid-sheen {
            opacity: 1;
        }

        /* =========================================================
           6. قاعة السينما والتتر المتحرك (Movie Credits Crawl)
           ========================================================= */
        .cinema-viewport {
            position: relative;
            height: 54vh;
            min-height: 380px;
            max-height: 540px;
            overflow: hidden;
            background: radial-gradient(ellipse at center, #140410 0%, #040106 100%);
            mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%);
            -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%);
        }

        .credits-roller {
            position: absolute;
            width: 100%;
            left: 0;
            top: 0;
            will-change: transform;
        }

        /* شريط التمرير المخصص */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: #050208; }
        ::-webkit-scrollbar-thumb { background: linear-gradient(#d90429, #f5d08a); border-radius: 10px; }
    </style>
</head>
<body class="selection:bg-rubyRoyal selection:text-white">

    <!-- خلفية الضباب المضيء المتحركة -->
    <div class="nebula-backdrop">
        <div class="nebula-cloud cloud-ruby"></div>
        <div class="nebula-cloud cloud-gold"></div>
        <div class="nebula-cloud cloud-center"></div>
    </div>

    <!-- كانفاس النجوم المتلألئة، أثر الماوس/اللمس، بتلات الورد، والألعاب النارية -->
    <canvas id="universeCanvas" class="fixed inset-0 pointer-events-none z-20"></canvas>

    <!-- ستارة الانتقال الضوئية بين المشاهد -->
    <div id="lightCurtain" class="light-curtain"></div>

    <!-- شريط التحكم العلوي العائم -->
    <nav class="fixed top-4 left-4 right-4 z-40 flex items-center justify-between pointer-events-none">
        <!-- زر كتم/تشغيل موسيقى البيانو الرومانسية -->
        <button id="audioToggleBtn" onclick="togglePianoMusic()" class="pointer-events-auto editorial-glass px-4 py-2.5 rounded-full text-xs sm:text-sm text-champagne hover:scale-105 active:scale-95 transition flex items-center gap-2.5 shadow-lg">
            <span class="relative flex h-2.5 w-2.5">
                <span id="audioPing" class="hidden animate-ping absolute inline-flex h-full w-full rounded-full bg-rubyGlow opacity-80"></span>
                <span id="audioDot" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-champagne"></span>
            </span>
            <i id="audioIcon" class="fas fa-volume-xmark"></i>
            <span id="audioLabel">تشغيل الموسيقى</span>
        </button>

        <!-- زر تخصيص الموقع للعميل (يُحذف تلقائياً في النسخة المصدرة) -->
        <div id="customizerCornerWrapper" class="pointer-events-auto">
            <button onclick="openCustomizerDrawer()" class="editorial-glass px-4 py-2.5 rounded-full text-xs sm:text-sm text-white hover:text-champagne hover:scale-105 active:scale-95 transition flex items-center gap-2 border border-champagne/40 shadow-lg">
                <span>تخصيص الموقع</span>
                <i class="fas fa-gear text-champagne animate-spin" style="animation-duration: 9s;"></i>
            </button>
        </div>
    </nav>

    <!-- =========================================================
         المشهد الأول: شاشة التحميل السحرية "نسبة حبي ليكي" (0% -> 100%)
         ========================================================= -->
    <section id="scene1" class="cinematic-scene active-scene visible-scene relative z-30 min-h-screen flex-col items-center justify-center px-5 py-16 text-center">
        <div class="max-w-lg w-full editorial-glass rounded-[2.5rem] p-8 sm:p-12 relative">
            
            <!-- تحية باسم الحبيبة -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-champagne/30 mb-5">
                <i class="fas fa-sparkles text-champagne text-xs"></i>
                <span id="displayHerGreeting" class="text-xs sm:text-sm font-bold text-roseSilk">إلى أميرتي وحبيبة عمري</span>
            </div>

            <!-- العنوان المطلوب بخط عربي فاخر ومتوهج -->
            <h1 class="font-ruqaa text-4xl sm:text-6xl gold-foil-text mb-7 leading-snug">
                نسبة حبي ليكي
            </h1>

            <!-- حلقة الطاقة الذهبية والياقوتية + القلب الزجاجي 3D -->
            <div id="energyCoreBox" class="relative w-64 h-64 sm:w-72 sm:h-72 mx-auto mb-6 flex items-center justify-center">
                <svg class="w-full h-full overflow-visible" viewBox="0 0 280 280">
                    <defs>
                        <linearGradient id="royalEnergyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#ff1e56" />
                            <stop offset="50%" stop-color="#f5d08a" />
                            <stop offset="100%" stop-color="#d90429" />
                        </linearGradient>
                        <filter id="royalGlow" x="-30%" y="-30%" width="160%" height="160%">
                            <feGaussianBlur stdDeviation="5.5" result="blur" />
                            <feMerge>
                                <feMergeNode in="blur" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                    </defs>

                    <!-- حلقة طاقة خارجية ذهبية -->
                    <circle cx="140" cy="140" r="128" fill="none" stroke="rgba(245, 208, 138, 0.22)" stroke-width="1.5" stroke-dasharray="6 10" class="energy-ring-cw" />
                    <g class="energy-ring-cw">
                        <circle cx="140" cy="12" r="5" fill="#f5d08a" filter="url(#royalGlow)" />
                    </g>

                    <!-- حلقة طاقة داخلية ياقوتية -->
                    <circle cx="140" cy="140" r="95" fill="none" stroke="rgba(255, 30, 86, 0.28)" stroke-width="1.2" stroke-dasharray="14 8" class="energy-ring-ccw" />
                    <g class="energy-ring-ccw">
                        <circle cx="140" cy="45" r="4" fill="#ff1e56" filter="url(#royalGlow)" />
                    </g>

                    <!-- مسار الخلفية -->
                    <circle cx="140" cy="140" r="112" fill="none" stroke="rgba(255, 255, 255, 0.06)" stroke-width="12" />

                    <!-- شريط التقدم المضيء -->
                    <circle id="progressRing" cx="140" cy="140" r="112" fill="none"
                            stroke="url(#royalEnergyGrad)" stroke-width="12" stroke-linecap="round"
                            stroke-dasharray="703.71" stroke-dashoffset="703.71"
                            transform="rotate(-90 140 140)"
                            filter="url(#royalGlow)" />
                </svg>

                <!-- محتوى المنتصف: القلب الزجاجي والرقم ثم اللانهاية -->
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <!-- أيقونة قلب زجاجي ثلاثي الأبعاد -->
                    <div id="glassHeartWrapper" class="glass-heart-3d mb-2">
                        <svg width="54" height="54" viewBox="0 0 64 64" fill="none">
                            <defs>
                                <linearGradient id="glassHeartGrad" x1="10" y1="8" x2="54" y2="58" gradientUnits="userSpaceOnUse">
                                    <stop offset="0%" stop-color="#ff6b8b" />
                                    <stop offset="45%" stop-color="#ff1e56" />
                                    <stop offset="100%" stop-color="#800020" />
                                </linearGradient>
                                <linearGradient id="glassHighlight" x1="16" y1="12" x2="36" y2="32" gradientUnits="userSpaceOnUse">
                                    <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
                                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <path d="M32 56C32 56 8 40.5 8 22.5C8 14.5 14.3 8.5 21.8 8.5C26.4 8.5 30.3 10.9 32 14.4C33.7 10.9 37.6 8.5 42.2 8.5C49.7 8.5 56 14.5 56 22.5C56 40.5 32 56 32 56Z" fill="url(#glassHeartGrad)" stroke="#f5d08a" stroke-width="1.5"/>
                            <path d="M14 21C14 15.5 18 12.5 22.5 12.5C25.5 12.5 28 14 29 16.5C24 16.5 19.5 19.5 18.5 25C16.5 24.5 14 23 14 21Z" fill="url(#glassHighlight)"/>
                        </svg>
                    </div>

                    <!-- العداد الرقمي -->
                    <div id="numericCounterBox" class="flex items-baseline justify-center" dir="ltr">
                        <span id="lovePercentNum" class="text-5xl sm:text-6xl font-black text-white ruby-text-glow tracking-tight">0</span>
                        <span class="text-2xl font-extrabold text-champagne ml-0.5">%</span>
                    </div>

                    <!-- رمز اللانهاية عند 100% -->
                    <div id="infinityRevealBox" class="hidden flex-col items-center">
                        <span class="text-6xl sm:text-7xl font-black gold-foil-text leading-none animate-pulse">∞</span>
                        <span class="text-xs sm:text-sm font-bold text-champagne mt-1 tracking-wide">حبي ليكي مالوش حدود</span>
                    </div>
                </div>
            </div>

            <!-- العبارات الرومانسية المتغيرة أثناء العد -->
            <p id="dynamicLoveQuote" class="font-amiri text-2xl sm:text-3xl text-roseSilk min-h-[3.6rem] flex items-center justify-center px-2 transition-all duration-300">
                ببدأ أعد نبضات قلبي أول ما اسمك ييجي في بالي...
            </p>

            <!-- زر الدخول المغناطيسي بعد الوصول لـ 100% -->
            <div class="mt-6 min-h-[4rem] flex items-center justify-center">
                <button id="enterWorldBtn" onclick="enterOurWorld()" class="hidden magnetic-gold-btn w-full py-4 px-8 rounded-2xl font-black text-lg sm:text-xl flex items-center justify-center gap-3 cursor-pointer">
                    <span>ادخلي عالمنا ✨</span>
                    <i class="fas fa-arrow-left"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- =========================================================
         المشهد الثاني: كشف اليوم المميز (The Milestone Reveal)
         ========================================================= -->
    <section id="scene2" class="cinematic-scene relative z-30 min-h-screen flex-col items-center justify-center px-5 py-20 text-center">
        <div class="max-w-3xl w-full editorial-glass rounded-[2.6rem] p-8 sm:p-14 border border-champagne/40 relative">
            
            <!-- أيقونة تاج/نجمة ملكية -->
            <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-rubyRoyal/30 to-champagne/20 border border-champagne/50 flex items-center justify-center shadow-xl">
                <i class="fas fa-crown text-2xl text-champagne"></i>
            </div>

            <!-- عنوان متوهج -->
            <h2 id="displayMilestoneHeading" class="font-ruqaa text-3xl sm:text-5xl gold-foil-text mb-6 leading-snug">
                اليوم اللي بدأت فيه حكايتنا
            </h2>

            <!-- إطار التاريخ المميز المهيب -->
            <div class="my-6 py-8 px-6 rounded-3xl bg-black/45 border border-champagne/35 shadow-inner">
