                            ${photo.caption || 'أجمل لحظة في عمري'}
                        </p>
                    </div>
                `;

                const card = wrap.querySelector('.polaroid-card');
                const sheen = wrap.querySelector('.polaroid-sheen');

                card.addEventListener('mousemove', e => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const rx = ((y - rect.height / 2) / (rect.height / 2)) * -11;
                    const ry = ((x - rect.width / 2) / (rect.width / 2)) * 11;
                    card.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg) scale3d(1.04, 1.04, 1.04)`;
                    sheen.style.background = `radial-gradient(circle at ${(x / rect.width) * 100}% ${(y / rect.height) * 100}%, rgba(245, 208, 138, 0.3), transparent 65%)`;
                });

                card.addEventListener('mouseleave', () => {
                    card.style.transform = `rotate(${baseAngle}deg) scale3d(1, 1, 1)`;
                });

                grid.appendChild(wrap);
            });
        }

