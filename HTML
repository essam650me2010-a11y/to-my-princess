        /* =========================================================
           5. المشهد الأول: عداد نسبة الحب المئوية (0% إلى 100%)
           ========================================================= */
        let loaderAnimationId = null;

        function startLoveLoaderSequence() {
            const ring = document.getElementById('progressRing');
            const numEl = document.getElementById('lovePercentNum');
            const quoteEl = document.getElementById('dynamicLoveQuote');
            const numBox = document.getElementById('numericCounterBox');
            const infBox = document.getElementById('infinityRevealBox');
            const enterBtn = document.getElementById('enterWorldBtn');

            const circumference = 2 * Math.PI * 112; // ~703.71
            ring.style.strokeDasharray = circumference;
            ring.style.strokeDashoffset = circumference;

            numBox.classList.remove('hidden');
            infBox.classList.add('hidden');
            infBox.classList.remove('flex');
            enterBtn.classList.add('hidden');
            numEl.textContent = '0';

            const stages = [
                { at: 0, text: "ببدأ أعد نبضات قلبي أول ما اسمك ييجي في بالي..." },
                { at: 25, text: "25%.. ده لسه مجرد نظرة واحدة من عيونك!" },
                { at: 50, text: "50%.. قلبي خلاص مبقاش شايف غيرك في الدنيا" },
                { at: 75, text: "75%.. كل تفصيلة فيكي بتخليني أحبك أكتر وأكتر" },
                { at: 95, text: "99%.. مفيش أرقام في الكون تقدر توصف غلاوتك..." }
            ];

            let lastStage = -1;
            const totalDuration = 4600; // تسارع درامي لمدة 4.6 ثانية
            const t0 = performance.now();

            if (loaderAnimationId) cancelAnimationFrame(loaderAnimationId);

            function step(now) {
                const elapsed = now - t0;
                const rawProgress = Math.min(elapsed / totalDuration, 1);
                // منحنى تسارع درامي (يبدأ بهدوء ثم يتسارع ثم يستقر عند 100%)
                const eased = rawProgress < 0.5
                    ? 2 * rawProgress * rawProgress
                    : 1 - Math.pow(-2 * rawProgress + 2, 2) / 2;

                const pct = Math.floor(eased * 100);
                numEl.textContent = pct;
                ring.style.strokeDashoffset = circumference - (eased * circumference);

                for (let i = stages.length - 1; i >= 0; i--) {
                    if (pct >= stages[i].at && lastStage !== stages[i].at) {
                        lastStage = stages[i].at;
                        quoteEl.style.opacity = '0';
                        setTimeout(() => {
                            quoteEl.textContent = stages[i].text;
                            quoteEl.style.opacity = '1';
                        }, 140);
                        break;
                    }
                }

                if (rawProgress < 1) {
                    loaderAnimationId = requestAnimationFrame(step);
                } else {
                    // الوصول لـ 100%: انفجار ضوئي + بتلات ورد + تحول لـ ∞ + ظهور الزر المغناطيسي
                    onReach100Percent(numBox, infBox, quoteEl, enterBtn);
                }
            }

            loaderAnimationId = requestAnimationFrame(step);
        }

        function onReach100Percent(numBox, infBox, quoteEl, enterBtn) {
            const coreRect = document.getElementById('energyCoreBox').getBoundingClientRect();
            spawnFireworkBurst(coreRect.left + coreRect.width / 2, coreRect.top + coreRect.height / 2, 85);
            showerRosePetals(50);

            setTimeout(() => {
                numBox.classList.add('hidden');
                infBox.classList.remove('hidden');
                infBox.classList.add('flex');
                quoteEl.textContent = "اكتملت النسبة.. ولسه حبي ليكي بيزيد كل ثانية!";
                enterBtn.classList.remove('hidden');
            }, 400);
        }

