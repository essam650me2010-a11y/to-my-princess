        const tiltAngles = [-2.2, 1.8, -1.5, 2.1, -1.8, 1.5];

        function renderPolaroidGallery() {
            const grid = document.getElementById('polaroidGalleryGrid');
            grid.innerHTML = '';

            appData.photos.forEach((photo, idx) => {
                const baseAngle = tiltAngles[idx % tiltAngles.length];
                const wrap = document.createElement('div');
                wrap.className = 'polaroid-perspective';
                const safeUrl = photo.url || ATTACHED_MEMORY_IMAGE;

                wrap.innerHTML = `
                    <div class="polaroid-card cursor-pointer group" style="transform: rotate(${baseAngle}deg);" onclick="openLightbox(${idx})">
                        <div class="polaroid-sheen"></div>
                        <div class="relative aspect-square rounded-2xl overflow-hidden mb-4 bg-black/50 border border-white/10">
                            <img src="${safeUrl}" alt="ذكرى سعيدة"
                                 onerror="if(this.src.indexOf('${ATTACHED_MEMORY_IMAGE}') === -1) { this.src='${ATTACHED_MEMORY_IMAGE}'; }"
